# Copy this file to `.env` and fill in your Groq API key.
# `search_agent.config` loads this automatically via python-dotenv.

GROQ_API_KEY=gsk_your-groq-key-here

# Optional overrides (defaults shown):
# SEARCH_AGENT_LLM_MODEL=llama-3.3-70b-versatile
# SEARCH_AGENT_MAX_TOKENS=1024
# SEARCH_AGENT_TEMPERATURE=0.7
# SEARCH_AGENT_LLM_MAX_RETRIES=2
# SEARCH_AGENT_TOP_K=20
# SEARCH_AGENT_LOG_LEVEL=INFO
# SEARCH_AGENT_LOG_TO_FILE=false
# SEARCH_AGENT_DATA_DIR=./data
# SEARCH_AGENT_LOG_DIR=./logs
